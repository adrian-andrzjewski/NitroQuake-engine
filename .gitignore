# Windows-hosted DOS build output and emulator staging.
/out/
/testdata/

# Stray files from legacy direct-to-repository DOS runs. The supported runners
# stage these under /out/; keep accidental root-level output out of Git too.
/quake.exe
/qbench.exe
/qprof.exe
/timedemo.txt
/timedemo.jsn
/profile.jsn
/FRAME.PCX
/FRAMECHE.TXT

# Local compiler/emulator cache if a user points the bootstrapper here.
/tools/.cache/

# Legacy/compiler intermediates.
*.obj
*.o
*.map
*.err
*.log

# Python test/tool caches and coverage output.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local IDE metadata.
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Editor, operating-system, and crash-report files.
*.tmp
*.temp
*.bak
*.swp
*~
*.dmp
*.stackdump
.DS_Store
Thumbs.db
Desktop.ini
